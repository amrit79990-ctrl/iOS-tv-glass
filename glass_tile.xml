<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <corners android:radius="16dp"/>
            <gradient android:angle="135" android:startColor="#344C79" android:endColor="#14243F"/>
            <stroke android:width="2dp" android:color="#48B8FF"/>
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="16dp"/>
            <gradient android:angle="135" android:startColor="#26334A" android:endColor="#111B2D"/>
            <stroke android:width="1dp" android:color="#536783"/>
        </shape>
    </item>
</selector>
